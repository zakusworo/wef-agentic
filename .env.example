# WEF-Agentic — environment variables
# Copy file ini ke `.env`, isi nilai yang relevan dengan setup Anda.

# ──────────────────────────────────────────────────────────────────────────
# LLM provider keys
# ──────────────────────────────────────────────────────────────────────────

# Opsi A — Claude Agent SDK (pakai Claude Code subscription, no API key)
# Cukup pastikan Claude Code CLI ter-install dan sudah login. Tidak ada env var.

# Opsi B — Ollama Cloud ($20/bulan, 3 concurrent models)
# Dapatkan key dari https://ollama.com (Settings → API Keys)
OLLAMA_API_KEY=

# Opsi C — Ollama Local (gratis, butuh `ollama serve` running)
# Default endpoint http://localhost:11434, override jika perlu.
OLLAMA_HOST=http://localhost:11434

# ──────────────────────────────────────────────────────────────────────────
# Runtime overrides (priority tertinggi, mengabaikan llm.yaml)
# ──────────────────────────────────────────────────────────────────────────

# Force semua agen pakai provider tertentu.
# Valid: ollama-local | ollama-cloud | claude-agent-sdk
# Kosong = pakai default dari config/llm.yaml.
WEF_AGENTIC_PROVIDER_OVERRIDE=

# Force semua agen pakai model tertentu (mengabaikan model_local/model/model_claude per agent).
# Contoh: gemma4:e4b | deepseek-v4-pro:cloud | claude-sonnet-4-6
WEF_AGENTIC_MODEL_OVERRIDE=
